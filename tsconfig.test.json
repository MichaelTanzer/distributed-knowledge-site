{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node10",
    "jsx": "react-jsx",
    "target": "ES2022",
    "incremental": false,
    "plugins": []
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
